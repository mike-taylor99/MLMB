{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API: Start",
      "type": "shell",
      "command": "uvicorn app.main:create_app --factory --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/api",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/api"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Build",
      "type": "shell",
      "command": "docker build -t mlmb:local .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "pip install",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
